rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Guides: Allow public read, restrict write to admin (if authenticated)
    // Note: If using hardcoded login without Firebase Auth, rules cannot distinguish the admin.
    // In this environment, we'll allow write for demonstration purposes, 
    // but RECOMMEND using Firebase Auth for production.
    match /guides/{guideId} {
      allow read: if true;
      allow write: if true; // In production, replace with: if request.auth != null && request.auth.token.email == 'admin@example.com';
    }
  }
}
